<!--
  Sample Hadoop client config for Celeborn DFS storage (HDFS / Ozone ofs:// / S3).

  This file is NOT consumed directly by the chart. Create a Secret from the files
  in this directory and point the chart at it with `configsSecretName`.

  The chart then mounts the keys listed in `hadoopConfigFiles` into each
  master/worker pod under /opt/celeborn/conf/.
-->
<configuration>
    <property>
        <name>fs.defaultFS</name>
        <value>hdfs://nameservice</value>
    </property>
</configuration>
