<!--
  Sample HDFS client config for Celeborn DFS storage. See core-site.xml in this
  directory for how the chart consumes these files (via `configsSecretName` and
  `hadoopConfigFiles`).
-->
<configuration>
    <property>
        <name>dfs.nameservices</name>
        <value>nameservice</value>
    </property>
    <property>
        <name>dfs.ha.namenodes.nameservice</name>
        <value>nn1,nn2</value>
    </property>
    <property>
        <name>dfs.namenode.rpc-address.nameservice.nn1</name>
        <value>namenode-0.example.internal:8020</value>
    </property>
    <property>
        <name>dfs.namenode.rpc-address.nameservice.nn2</name>
        <value>namenode-1.example.internal:8020</value>
    </property>
    <property>
        <name>dfs.client.failover.proxy.provider.nameservice</name>
        <value>org.apache.hadoop.hdfs.server.namenode.ha.ConfiguredFailoverProxyProvider</value>
    </property>
</configuration>
